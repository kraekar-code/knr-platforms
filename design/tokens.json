{
  "$description": "KNR Platforms design tokens. Every value is copied verbatim from the @theme block of app/globals.css, except productAccents, copied from the accent/accent2 fields of products in lib/site.ts. The @theme block defines no spacing or shadow tokens: spacing uses Tailwind's default scale and shadows are arbitrary values in components (see design/README.md).",
  "source": {
    "theme": "app/globals.css (@theme)",
    "productAccents": "lib/site.ts (products[].accent, products[].accent2)"
  },
  "color": {
    "ink": "#050505",
    "ink-2": "#0e0e11",
    "ink-3": "#17171c",
    "navy": "#0b1e4a",
    "blue": "#1e5bd8",
    "sky": "#2f8bff",
    "violet": "#7a6cc0",
    "amber": "#f2a64a",
    "coral": "#ff7a59",
    "mint": "#3ddc97",
    "fog": "#d4d4d8",
    "mist": "#8e8e99",
    "paper": "#f4f4f1",
    "paper-2": "#e9e9e4",
    "carbon": "#0a0a0a"
  },
  "productAccents": {
    "lumarcs": { "accent": "#2F8BFF", "accent2": "#7A6CC0" },
    "veyra": { "accent": "#F2A64A", "accent2": "#FF7A59" },
    "kairen": { "accent": "#7C5CFF", "accent2": "#2F8BFF" },
    "fliplab": { "accent": "#3DDC97", "accent2": "#2F8BFF" }
  },
  "font": {
    "display": "var(--font-sora), ui-sans-serif, system-ui, sans-serif",
    "body": "var(--font-inter), ui-sans-serif, system-ui, sans-serif"
  },
  "radius": {
    "xl2": "1.25rem",
    "xl3": "1.75rem"
  },
  "ease": {
    "out-expo": "cubic-bezier(0.16, 1, 0.3, 1)"
  },
  "animate": {
    "marquee": "marquee 40s linear infinite",
    "float": "float 7s ease-in-out infinite",
    "spin-slow": "spin 14s linear infinite",
    "pulse-soft": "pulse-soft 3s ease-in-out infinite",
    "dash": "dash 3s linear infinite",
    "scan": "scan 6s ease-in-out infinite"
  },
  "keyframes": {
    "marquee": {
      "from": { "transform": "translateX(0)" },
      "to": { "transform": "translateX(-50%)" }
    },
    "float": {
      "0%, 100%": { "transform": "translateY(0) rotate(0deg)" },
      "50%": { "transform": "translateY(-14px) rotate(-1.5deg)" }
    },
    "pulse-soft": {
      "0%, 100%": { "opacity": "0.55", "transform": "scale(1)" },
      "50%": { "opacity": "1", "transform": "scale(1.12)" }
    },
    "dash": {
      "to": { "stroke-dashoffset": "-40" }
    },
    "scan": {
      "0%": { "transform": "translateY(-20%)", "opacity": "0" },
      "15%": { "opacity": "1" },
      "85%": { "opacity": "1" },
      "100%": { "transform": "translateY(120%)", "opacity": "0" }
    }
  }
}
